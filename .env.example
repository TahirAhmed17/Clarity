# Clarity — environment variables. Copy to .env.local and fill in what you need.
# With NOTHING set, Clarity runs fully offline: bundled synthetic seed data + mock AI engine.
# Never commit real values. .env.local is git-ignored.

# ---------- Data ----------
# auto     = use DATABASE_URL if reachable, else fall back to bundled seed data (default)
# database = require the database (fail if unreachable)
# seed     = never touch a database
DATA_MODE=auto
# Supabase → Project Settings → Database → Connection string (URI). Pooler URLs work (prepare=false).
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_MS=3000

# ---------- AI ----------
# mock | gemini | lingsante
AI_ENGINE=mock
# If the selected engine is unavailable or fails, answer with the mock engine (shown to the user).
AI_FALLBACK_TO_MOCK=true
AI_TIMEOUT_MS=30000

# Google Gemini (primary). Use a model id currently listed by Google AI Studio — verify before use.
GEMINI_API_KEY=
GEMINI_MODEL=

# InclusionAI LingSante via OpenRouter (EXPERIMENTAL). The slug is NOT verified by this project —
# confirm it on openrouter.ai/models before setting.
OPENROUTER_API_KEY=
LINGSANTE_MODEL_ID=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------- Uploads ----------
MAX_REPORT_UPLOAD_MB=10
MAX_WEARABLE_UPLOAD_MB=50

# ---------- Brand (public) ----------
# none | by-tafasa
NEXT_PUBLIC_BRAND_ENDORSEMENT=none

# ---------- Reviewer workspace (SIMULATED doctor view) ----------
# Access code for /doctor/sign-in (min 8 chars). Unset = the workspace is closed to everyone.
REVIEWER_ACCESS_CODE=
# Secret for signing reviewer session cookies (min 32 chars). Required in production;
# in development a random per-process secret is used if unset.
SESSION_SECRET=

# ---------- Demo ----------
# "Reset demo" (Profile page) always works in seed mode. In database mode it deletes every
# record on the synthetic demo profile, so it is off unless this is "true".
DEMO_RESET_ALLOWED=false
